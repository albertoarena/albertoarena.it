# Docroot .htaccess for the server-pull releases/current deploy mechanism.
#
# NOT deployed automatically. CI only ever publishes into releases/<ts>/;
# this file lives one level up, at the docroot root itself (e.g.
# ~/albertoarena.it/.htaccess on Netsons), and must be placed there by hand.
# This copy mirrors the live file — verify against the host after editing.
#
# The "Force HTTPS" block below is owned by cPanel's own Domains > Redirects
# feature, not hand-authored — don't touch it, manage HTTPS forcing through
# cPanel's UI instead. Custom RewriteRules added elsewhere in this file were
# tested extensively (2026-08-13, several independent conditions/patterns)
# and never took effect, while the cPanel-owned rule fired immediately — so
# this file cannot be trusted for anything beyond what cPanel itself
# manages. See DEPLOYMENT.md. Blocking current/releases/<ts>/ is instead
# handled in public/.htaccess (deployed automatically into every release,
# not requiring any hand-editing on the host) — see the comments there.
#
# Reusing on another Astro site with the same releases/current mechanism:
# swap the hardcoded domain in the Force HTTPS block for the target site's,
# keep everything else as-is, and put any custom rewrite logic in the
# release-level .htaccess (this project's public/.htaccess), not here.

Options +FollowSymLinks -Indexes

RewriteEngine on

# Force HTTPS — owned by cPanel's Domains > Redirects feature, kept as-is
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^albertoarena\.it$ [OR]
RewriteCond %{HTTP_HOST} ^www\.albertoarena\.it$
RewriteRule ^(.*)$ "https\:\/\/albertoarena\.it\/$1" [R=301,L]

# Route everything to the active release; block direct access to releases/
# (kept from the original setup — untested whether it actually fires, given
# the findings above, but harmless either way since public/.htaccess is the
# real enforcement mechanism now)
RewriteRule ^releases(/.*)?$ - [F,L]
RewriteCond %{REQUEST_URI} !^/current/
RewriteRule ^(.*)$ current/$1 [L]
