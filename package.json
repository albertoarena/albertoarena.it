{
  "name": "albertoarena.it-astro",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:eligibility": "astro build && vitest run tests/reader-eligibility.test.ts",
    "test:seo-indexing": "astro build && vitest run tests/seo-indexing.test.ts",
    "test:geo-aeo": "astro build && vitest run tests/geo-aeo.test.ts",
    "test:accessibility": "astro build && vitest run tests/accessibility.test.ts",
    "test:accessibility-components": "vitest run tests/components",
    "test:cheatsheet-pdf": "vitest run tests/cheatsheet-pdf.test.ts",
    "test:profile-readme": "vitest run tests/update-profile-readme.test.ts",
    "test:image-budget": "vitest run tests/image-budget.test.ts",
    "test": "npm run test:eligibility && npm run test:seo-indexing && npm run test:geo-aeo && npm run test:accessibility && npm run test:accessibility-components && npm run test:cheatsheet-pdf && npm run test:profile-readme && npm run test:image-budget",
    "pdf:cheatsheet": "node scripts/generate-cheatsheet-pdf.mjs",
    "covers:generate": "node scripts/generate-covers.mjs",
    "projects:fetch-stats": "node scripts/fetch-project-stats.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^5.0.0",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jsdom": "^28.0.3",
    "axe-core": "^4.13.0",
    "fast-xml-parser": "^5.10.1",
    "jsdom": "^27.0.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.43.1",
    "satori": "^0.29.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
