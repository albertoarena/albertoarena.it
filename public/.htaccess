# Canonicalize host: force https://albertoarena.it (no www, https only)
RewriteEngine On

# Redirect direct access to the deploy plumbing (current/, releases/<ts>/)
# to the equivalent canonical URL instead of serving it. This file is
# deployed identically into every release, so it applies whether reached via
# releases/<ts>/.htaccess directly or via the current/ symlink.
#
# %{THE_REQUEST} is the client's original request line, unaffected by the
# docroot .htaccess's internal current/ rewrite, so this only matches
# requests that actually target current/ or releases/<ts>/ directly — not
# the internally-rewritten request for a normal page view.
RewriteCond %{THE_REQUEST} \s/+(current|releases)(/|\?|\s) [NC]
RewriteRule ^(.*)$ https://albertoarena.it/$1 [R=301,L]

# Collapse host+scheme+trailing-slash normalization into a single 301
# (avoids a 2-hop chain for e.g. http://www.albertoarena.it/category/react)
RewriteCond %{HTTP_HOST} ^www\.albertoarena\.it$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
RewriteRule ^ https://albertoarena.it%{REQUEST_URI}/ [L,R=301]

# Existing host-only rewrite (root path, already-slashed paths, static files)
RewriteCond %{HTTP_HOST} ^www\.albertoarena\.it$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://albertoarena.it/$1 [L,R=301]

# Post slug renamed post-publish (2026-08-24): the title changed from "What
# a trusted connection was doing for you" to "The bug that only showed up
# once strangers could paste a schema" a few hours after it went live, so
# the old URL may already be cached/indexed. Safe to remove once confident
# nothing external still links to the old slug.
RewriteRule ^posts/what-a-trusted-connection-was-doing-for-you/?$ /posts/the-bug-that-only-showed-up-with-pasted-schemas/ [R=301,L]

# Custom error pages
#
# The local-path argument is resolved against the docroot, not this file's
# own directory — and the docroot has no 404.html of its own (it only
# exists inside current/, i.e. releases/<ts>/), so this must point through
# current/ explicitly or Apache silently falls back to its own default
# error page (found live 2026-08-13: bare /404.html never resolved).
ErrorDocument 404 /current/404.html

# MIME types
AddType application/xml .xml
