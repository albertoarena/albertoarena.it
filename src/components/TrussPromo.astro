---
/*
  Ledger identity (.impeccable/surfaces/site.md): no filled background.
  The old --surface "one filled block" rule (redesign-plan.md §3, §9.2) is
  superseded — a full-height tinted rail tried during this same redesign
  read as a dated dashboard sidebar, and keeping Truss's own box filled
  while the rest of the identity moved to rule-only surfaces would have
  made the two treatments fight each other. The box stays distinct through
  density, the Shipped stamp, and the double rule instead. The no-icon-set
  rule still stands, so the links below stay plain mono text matching
  every other link row (post tags, endnote, etc) — the one exception is
  the Truss mark next to the heading, see the `.project-mark` class in
  global.css for the size every future mark has to match.

  Version comes from the same project-stats.json cache /projects reads
  (scripts/fetch-project-stats.mjs, Phase 7), with this hardcoded string as
  the fallback so a stats file that's missing the entry — or missing
  entirely — never breaks the build, per the plan's own requirement.
*/
import { getCollection } from "astro:content";
import { getPostSlug } from "../utils/helpers";
import { trussSeries as trussSeriesData } from "../data/trussSeries";
import projectStats from "../data/project-stats.json";

const TRUSS_VERSION = projectStats['albertoarena/laravel-truss']?.version ?? "v1.14.1";

const posts = await getCollection("posts");

const trussSeries = trussSeriesData.map((entry) => ({
	...entry,
	date: posts.find((p) => getPostSlug(p) === entry.slug)?.data.date,
	hasItalian: posts.some((p) => p.data.lang === "it" && p.data.translationOf === entry.slug),
}));
---

<div class="border border-rule px-6 py-5">
	<div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2.5">
		<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="project-mark text-ink dark:text-white" aria-hidden="true">
			<path d="M16 5 L27 26 H5 Z" />
			<path d="M16 5 V17" />
			<path d="M5 26 L16 17" />
			<path d="M27 26 L16 17" />
			<circle cx="16" cy="5" r="1.4" fill="currentColor" stroke="none" />
			<circle cx="5" cy="26" r="1.4" fill="currentColor" stroke="none" />
			<circle cx="27" cy="26" r="1.4" fill="currentColor" stroke="none" />
			<circle cx="16" cy="17" r="1.4" fill="currentColor" stroke="none" />
		</svg>
		<h2 class="font-sans text-xl font-semibold text-ink dark:text-white">Laravel Truss</h2>
		<span class="stamp">&#10003; Shipped {TRUSS_VERSION}</span>
	</div>
	<p class="text-ink-2 max-w-[48ch] mb-5">
		A live, zoomable ER diagram of your Laravel app's actual database schema, safe to run in production. <strong class="font-semibold text-ink dark:text-white">Structure only, never data.</strong> Now speaks MCP, so a coding agent can read your live schema instead of a stale paste. A companion plugin, filament-truss, brings the same diagram into a Filament panel.
	</p>
	<div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm mb-5">
		<!--
			/docs has never existed on trussphp.com and returned 404 from this box.
			Quick start is the real first page of the documentation, and the link
			is tagged because a promo box is exactly the surface R14 names.
		-->
		<a href="https://trussphp.com/getting-started/quick-start/?utm_source=albertoarena.it&amp;utm_medium=referral&amp;utm_campaign=truss-promo" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Docs</a>
		<a href="https://github.com/albertoarena/laravel-truss" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">GitHub</a>
		<a href="https://packagist.org/packages/albertoarena/laravel-truss" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Install</a>
		<a href="https://github.com/albertoarena/filament-truss" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Filament plugin</a>
		<a href="https://ko-fi.com/albertoarena" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Support on Ko-fi</a>
	</div>
	<div class="pt-4 border-t-[3px] border-double border-rule">
		<h3 class="font-mono text-xs uppercase tracking-[0.14em] text-muted mb-2">How it got here</h3>
		<ol class="font-mono text-sm">
			{trussSeries.map((post, i) => (
				<li class="flex items-baseline justify-between gap-2 py-1">
					<span class="min-w-0">
						<span class="ledger-idx">{i + 1}</span>
						<a href={`/posts/${post.slug}/`} class="text-ink-2 hover:text-accent transition-colors">
							{post.title}
						</a>
						{post.date && (
							<time datetime={post.date.toISOString()} class="ml-2 text-xs text-muted whitespace-nowrap">
								{post.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
							</time>
						)}
					</span>
					{post.hasItalian && (
						<a
							href={`/posts/${post.slug}/it/`}
							class="shrink-0 text-[0.6875rem] tracking-wide text-muted border border-rule px-1.5 py-0.5 hover:text-accent hover:border-accent transition-colors"
						>
							IT
						</a>
					)}
				</li>
			))}
		</ol>
	</div>
</div>
