---
/*
  Redesign home page's one filled block (redesign-plan.md §3, §9.2): the
  only element on the page allowed to use --surface as a background. No
  icon set per the plan's constraints (§1), so the previous SVG icons are
  gone in favour of plain mono links, matching every other link row built
  so far (post tags, endnote, etc).

  Version comes from the same project-stats.json cache /projects reads
  (scripts/fetch-project-stats.mjs, Phase 7), with this hardcoded string as
  the fallback so a stats file that's missing the entry — or missing
  entirely — never breaks the build, per the plan's own requirement.
*/
import { getCollection } from "astro:content";
import { getPostSlug } from "../utils/helpers";
import { trussSeries as trussSeriesData } from "../data/trussSeries";
import projectStats from "../data/project-stats.json";

const TRUSS_VERSION = projectStats['albertoarena/laravel-truss']?.version ?? "v1.8.1";

const posts = await getCollection("posts");

const trussSeries = trussSeriesData.map((entry) => ({
	...entry,
	date: posts.find((p) => getPostSlug(p) === entry.slug)?.data.date,
	hasItalian: posts.some((p) => p.data.lang === "it" && p.data.translationOf === entry.slug),
}));
---

<div class="border border-rule bg-surface px-6 py-5">
	<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2.5">
		<h2 class="font-sans text-xl font-semibold text-ink dark:text-white">Laravel Truss</h2>
		<span class="font-mono text-xs text-accent border border-accent px-1.5 py-0.5">{TRUSS_VERSION}</span>
	</div>
	<p class="text-ink-2 max-w-[48ch] mb-5">
		A live, zoomable ER diagram of your Laravel app's actual database schema, safe to run in production because it only ever reads structure, never rows. <strong class="font-semibold text-ink dark:text-white">Now speaks MCP, so a coding agent can read your live schema instead of a stale paste.</strong>
	</p>
	<div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm mb-5">
		<a href="https://trussphp.com/docs" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Docs</a>
		<a href="https://github.com/albertoarena/laravel-truss" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">GitHub</a>
		<a href="https://packagist.org/packages/albertoarena/laravel-truss" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Install</a>
		<a href="https://ko-fi.com/albertoarena" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Support on Ko-fi</a>
	</div>
	<div class="pt-4 border-t border-rule">
		<h3 class="font-mono text-xs uppercase tracking-[0.14em] text-muted mb-2">How it got here</h3>
		<ol class="font-mono text-sm">
			{trussSeries.map((post, i) => (
				<li class="flex items-baseline justify-between gap-2 py-1">
					<span class="min-w-0">
						<span class="text-muted mr-2">{i + 1}</span>
						<a href={`/posts/${post.slug}/`} class="text-ink-2 hover:text-accent transition-colors">
							{post.title}
						</a>
						{post.date && (
							<time datetime={post.date.toISOString()} class="ml-2 text-xs text-muted whitespace-nowrap">
								{post.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
							</time>
						)}
					</span>
					{post.hasItalian && (
						<a
							href={`/posts/${post.slug}/it/`}
							class="shrink-0 text-[0.6875rem] tracking-wide text-muted border border-rule px-1.5 py-0.5 hover:text-accent hover:border-accent transition-colors"
						>
							IT
						</a>
					)}
				</li>
			))}
		</ol>
	</div>
</div>
