---

<div
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 z-50 p-4 bg-paper border-t border-rule shadow-lg"
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
>
  <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="text-sm text-ink dark:text-white">
      <p id="cookie-consent-title" class="font-semibold mb-1">We use cookies</p>
      <p id="cookie-consent-description" class="text-ink-2">
        We use analytics cookies to understand how you use this site and improve your experience.
        No advertising or profiling cookies are used.
        <a href="/pages/privacy-policy/" class="underline hover:text-accent transition-colors ml-1">Privacy Policy</a>
      </p>
    </div>
    <div class="flex gap-3 flex-shrink-0">
      <button
        id="decline-cookies"
        class="px-4 py-2 text-sm text-muted hover:text-ink dark:hover:text-white transition-colors"
        aria-label="Decline analytics cookies"
      >
        Decline
      </button>
      <button
        id="accept-cookies"
        class="px-4 py-2 text-sm bg-accent text-white hover:bg-accent/90 transition-colors"
        aria-label="Accept analytics cookies"
      >
        Accept analytics
      </button>
    </div>
  </div>
</div>

<script is:inline>
  // The GTM script tag itself is not created until __loadGTM runs (defined
  // in BaseLayout.astro's head script), so accepting here is the first
  // moment anything is fetched from Google.
  function initCookieConsent() {
    const consent = localStorage.getItem('cookieConsent');
    const banner = document.getElementById('cookie-consent');

    // A tag already loaded cannot be unloaded, so withdrawal reloads the
    // page: consent goes back to unset, __loadGTM is not called on the next
    // load, and the banner returns. Registered before the branch below,
    // because the only people who need it are the ones who have already
    // answered.
    document.querySelector('[data-consent-reset]')?.addEventListener('click', () => {
      window.gtag?.('consent', 'update', { analytics_storage: 'denied' });
      localStorage.removeItem('cookieConsent');
      location.reload();
    });

    if (consent) {
      banner?.remove();
      return;
    }

    document.getElementById('accept-cookies')?.addEventListener('click', () => {
      localStorage.setItem('cookieConsent', 'accepted');
      window.__loadGTM?.();
      banner?.remove();
    });

    document.getElementById('decline-cookies')?.addEventListener('click', () => {
      localStorage.setItem('cookieConsent', 'declined');
      banner?.remove();
    });
  }

  initCookieConsent();
  document.addEventListener('astro:after-swap', initCookieConsent);
</script>
