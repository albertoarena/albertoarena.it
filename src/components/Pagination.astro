---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages, basePath = '' } = Astro.props;

const prevPage = currentPage > 1
  ? currentPage === 2
    ? (basePath ? `${basePath}/` : '/')
    : `${basePath}/page/${currentPage - 1}/`
  : null;

const nextPage = currentPage < totalPages
  ? `${basePath}/page/${currentPage + 1}/`
  : null;
---

{totalPages > 1 && (
  <nav class="mt-12 pt-6 border-t border-rule flex justify-between items-center font-mono text-sm" aria-label="Pagination">
    {prevPage ? (
      <a href={prevPage} class="text-accent hover:underline">&larr; Previous</a>
    ) : (
      <span />
    )}

    <span class="text-muted">
      Page {currentPage} of {totalPages}
    </span>

    {nextPage ? (
      <a href={nextPage} class="text-accent hover:underline">Next &rarr;</a>
    ) : (
      <span />
    )}
  </nav>
)}
