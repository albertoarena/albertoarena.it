---
/*
  Compact EN · IT control for the post meta line and aside, and the /pages/
  sub-header (redesign-plan.md §7). Only ever rendered by a caller that has
  already confirmed both language versions exist — no disabled/stub state,
  so a reader never sees a language option that doesn't actually go anywhere.
*/
interface Props {
  lang: 'en' | 'it';
  englishUrl: string;
  italianUrl: string;
}

const { lang, englishUrl, italianUrl } = Astro.props;
---

<span class="font-mono">
  <a
    href={englishUrl}
    aria-current={lang === 'en' ? 'page' : undefined}
    class:list={lang === 'en' ? 'text-ink dark:text-white font-semibold' : 'text-accent hover:underline'}
  >EN</a>
  <span class="text-muted"> &middot; </span>
  <a
    href={italianUrl}
    aria-current={lang === 'it' ? 'page' : undefined}
    class:list={lang === 'it' ? 'text-ink dark:text-white font-semibold' : 'text-accent hover:underline'}
  >IT</a>
</span>
