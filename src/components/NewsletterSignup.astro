---
import { siteConfig } from '@/utils/config';

const { accountId, formId } = siteConfig.mailerlite;
---

<div data-form={formId} class="ml-embedded newsletter-signup-target"></div>

<script is:inline define:vars={{ accountId }}>
  function loadMailerLite() {
    (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
    .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
    n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
    (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
    ml('account', accountId);
  }

  function initNewsletterSignup() {
    var target = document.querySelector('.newsletter-signup-target');
    // Already wired up: either a fresh page's target we've already handled,
    // or (post-to-post navigation) the same transition:persist node carried
    // over from the previous page, already loaded or already being watched.
    if (!target || target.dataset.mlObserved === '1') return;
    target.dataset.mlObserved = '1';

    if ('IntersectionObserver' in window) {
      // Generous rootMargin, not just the viewport: a same-page anchor jump
      // (clicking a TOC link, scroll-behavior: smooth) can move the target
      // through the viewport fast enough to slip between two observer check
      // frames at the default 0px margin, which never fires isIntersecting
      // at all and leaves the form permanently unloaded. A wide buffer makes
      // that gap far less likely regardless of how the scroll happened.
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            observer.disconnect();
            loadMailerLite();
          }
        });
      }, { rootMargin: '600px 0px' });
      observer.observe(target);
    } else {
      loadMailerLite();
    }
  }

  // Astro's View Transitions swap doesn't re-execute an inline script whose
  // content is byte-identical to one that already ran elsewhere in the
  // session (this component renders the same script on every post and on
  // /subscribe), so a target introduced by a client-side navigation from a
  // page with no newsletter box of its own (e.g. home -> a post) would
  // otherwise never get observed.
  initNewsletterSignup();
  document.addEventListener('astro:after-swap', initNewsletterSignup);
</script>
