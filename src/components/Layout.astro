---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Rail from '@/components/Rail.astro';
import ThemeSwitcher from '@/components/ThemeSwitcher.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  lang?: 'en' | 'it';
  hreflangEn?: string;
  hreflangIt?: string;
  noViewTransitions?: boolean;
  noindex?: boolean;
  wide?: boolean;
}

const { title, description, image, article = false, lang = 'en', hreflangEn, hreflangIt, noViewTransitions = false, noindex = false, wide = false } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  article={article}
  lang={lang}
  hreflangEn={hreflangEn}
  hreflangIt={hreflangIt}
  noViewTransitions={noViewTransitions}
  noindex={noindex}
>
  <!-- Shell A, two column (redesign-plan.md §5): rail | main -->
  <div class="min-[900px]:grid min-[900px]:grid-cols-[14rem_minmax(0,1fr)] max-w-[82rem] mx-auto">
    <Rail hreflangEn={hreflangEn} hreflangIt={hreflangIt} />
    <div class="min-w-0 min-[900px]:col-start-2">
      <div class="flex justify-end px-6 pt-6 min-[900px]:px-8 min-[900px]:pt-8">
        <ThemeSwitcher />
      </div>
      <main id="main-content" class:list={[wide ? 'max-w-5xl' : 'max-w-3xl', 'mx-auto px-6 pb-12 animate-fade-in']}>
        <slot />
      </main>
      <Footer />
    </div>
  </div>
  <CookieConsent />
</BaseLayout>
