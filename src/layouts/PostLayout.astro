---
import BaseLayout from "./BaseLayout.astro";
import Rail from "../components/Rail.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import type { CollectionEntry } from "astro:content";
import { siteConfig } from "../utils/config";
import DisqusComments from "../components/DisqusComments.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import ReadingModeToggle from "../components/ReadingModeToggle.astro";
import TrussSeriesNav from "../components/TrussSeriesNav.astro";
import { trussSeries } from "../data/trussSeries";
import readingTime from "reading-time";

interface Props {
    post: CollectionEntry<"posts">;
    slug: string;
    lang?: 'en' | 'it';
    englishUrl?: string;
    italianUrl?: string;
    disqusSlug?: string;
}

const { post, slug, lang = 'en', englishUrl, italianUrl, disqusSlug } = Astro.props;

const locale = lang === 'it' ? 'it-IT' : 'en-US';
const formattedDate = post.data.date.toLocaleDateString(locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});

const categorySlug = post.data.category?.toLowerCase().replace(/\s+/g, '-');
const readTime = readingTime(post.body).text;

const canonicalEnglishSlug = disqusSlug ?? slug;
const disqusPostUrl = `${siteConfig.url}/posts/${canonicalEnglishSlug}/`;

const hasTranslation = !!(englishUrl && italianUrl);
const isTrussSeriesPost = trussSeries.some((entry) => entry.slug === slug);
const hreflangEn = englishUrl ? `${siteConfig.url}${englishUrl}` : undefined;
const hreflangIt = italianUrl ? `${siteConfig.url}${italianUrl}` : undefined;

const articleImageURL = new URL(post.data.socialImage ?? siteConfig.author.photo, siteConfig.url).toString();
const postCanonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const blogPostingSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: articleImageURL,
    datePublished: post.data.date.toISOString(),
    author: { '@id': `${siteConfig.url}/#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': postCanonicalURL },
};
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    image={post.data.socialImage}
    article={true}
    lang={lang}
    hreflangEn={hreflangEn}
    hreflangIt={hreflangIt}
>
  <!-- Shell B, three column (redesign-plan.md §5): rail | article | aside -->
  <div class="post-shell min-[900px]:grid min-[900px]:grid-cols-[14rem_minmax(0,1fr)] min-[1180px]:grid-cols-[14rem_minmax(0,1fr)_15rem] max-w-[82rem] mx-auto">
    <Rail hreflangEn={hreflangEn} hreflangIt={hreflangIt} />
    <div class="post-shell-main min-w-0 min-[900px]:col-start-2">
      <div class="flex justify-end px-6 pt-6 min-[900px]:px-8 min-[900px]:pt-8">
        <ThemeSwitcher />
      </div>
    <main id="main-content" class="px-6 pb-12 min-[900px]:px-8 min-[900px]:pb-16">
    <article class="post-content">
        <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

        <!-- Full-width post header -->
        <header class="mb-10">
            {(hasTranslation || isTrussSeriesPost) && (
                <div class="flex items-center justify-between gap-4 mb-6 not-prose">
                    {hasTranslation ? (
                        <LanguageToggle
                            currentLang={lang}
                            englishUrl={englishUrl!}
                            italianUrl={italianUrl!}
                        />
                    ) : <span />}
                    {isTrussSeriesPost && (
                        <a
                            href="#truss-series"
                            class="text-sm font-medium text-gray hover:text-primary transition-colors whitespace-nowrap"
                        >
                            {lang === 'it' ? 'Serie Truss ↓' : 'Truss series ↓'}
                        </a>
                    )}
                </div>
            )}
            <h1 class="text-4xl font-bold leading-tight mb-4 text-dark dark:text-white">{post.data.title}</h1>
            <div class="flex flex-wrap items-center gap-4 text-sm font-mono text-gray">
                <time datetime={post.data.date.toISOString()} class="no-underline">
                    {formattedDate}
                </time>
                {post.data.category && (
                    <a
                        href={`/category/${categorySlug}/`}
                        class="px-2 py-1 bg-primary/10 dark:bg-dark-cloud text-primary dark:text-white-cloud rounded font-medium hover:bg-primary/20 transition-colors"
                    >
                        {post.data.category}
                    </a>
                )}
                <span>{readTime}</span>
            </div>
        </header>

        <!-- Prose body at reading measure -->
        <div class="prose dark:prose-invert max-w-[68ch]">
            <slot />
        </div>

        {isTrussSeriesPost && (
            <TrussSeriesNav currentSlug={slug} lang={lang} />
        )}

        <!-- Full-width post footer -->
        {post.data.tags && post.data.tags.length > 0 && (
            <footer class="post-tags mt-12 pt-6 border-t border-white-cloud dark:border-dark-cloud">
                <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                        <a
                            href={`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
                            class="px-3 py-1 bg-gray-100 dark:bg-dark-cloud text-gray-700 dark:text-white-cloud rounded-full text-sm hover:bg-secondary hover:text-white transition-colors"
                        >
                            #{tag}
                        </a>
                    ))}
                </div>
            </footer>
        )}

        <div class="post-author mt-12 pt-6 border-t border-white-cloud dark:border-dark-cloud">
            <div class="flex items-center gap-4">
                <img
                    src={siteConfig.author.photo}
                    alt={siteConfig.author.name}
                    class="w-14 h-14 rounded-full"
                />
                <div>
                    <p class="font-semibold text-dark dark:text-white">{siteConfig.author.name}</p>
                    <p class="text-sm text-gray">{siteConfig.author.bio}</p>
                </div>
            </div>
        </div>

        <div
            class="post-newsletter mt-12 pt-6 border-t border-white-cloud dark:border-dark-cloud"
            transition:persist
            transition:name="newsletter-signup"
        >
            <h2 class="text-lg font-semibold text-dark dark:text-white mb-1">Liked this? Get the next one.</h2>
            <p class="text-sm text-gray leading-relaxed mb-4">
                Practical notes on Laravel tooling and AI-assisted development, about once a month.
                Join the list and I'll send you my
                <a href="/cheatsheets/spatie-event-sourcing/" class="hover:text-primary transition-colors underline underline-offset-2">Spatie Event Sourcing cheat sheet</a>
                to start.
            </p>
            <NewsletterSignup />
        </div>

        <DisqusComments
            url={disqusPostUrl}
            identifier={canonicalEnglishSlug}
            title={post.data.title}
        />
    </article>
    </main>
      <Footer />
    </div>
    <!-- Aside content (On this page, series thread, Reference) lands in Phase 3 -->
    <aside class="hidden min-[1180px]:block border-l border-rule px-5 py-9"></aside>
  </div>

  <ReadingModeToggle />
  <CookieConsent />
</BaseLayout>
