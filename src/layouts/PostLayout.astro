---
import BaseLayout from "./BaseLayout.astro";
import Rail from "../components/Rail.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import PostLangSwitch from "../components/PostLangSwitch.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { siteConfig } from "../utils/config";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import ReadingModeToggle from "../components/ReadingModeToggle.astro";
import { getPostSlug } from "../utils/helpers";
import { getSeriesEntry } from "../data/series";
import readingTime from "reading-time";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    post: CollectionEntry<"posts">;
    slug: string;
    lang?: 'en' | 'it';
    englishUrl?: string;
    italianUrl?: string;
    headings?: Heading[];
}

const { post, slug, lang = 'en', englishUrl, italianUrl, headings = [] } = Astro.props;

const locale = lang === 'it' ? 'it-IT' : 'en-US';
const formattedDate = post.data.date.toLocaleDateString(locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});

const categorySlug = post.data.category?.toLowerCase().replace(/\s+/g, '-');
const readTime = readingTime(post.body).text;

const hreflangEn = englishUrl ? `${siteConfig.url}${englishUrl}` : undefined;
const hreflangIt = italianUrl ? `${siteConfig.url}${italianUrl}` : undefined;

// Always resolvable regardless of which route rendered this page, unlike the
// hreflang props above (only set when Astro.props supplies them).
const postEnglishUrl = `/posts/${slug}/`;
const postItalianUrl = (englishUrl && italianUrl) || lang === 'it' ? `/posts/${slug}/it/` : undefined;

const coverSrc = post.data.cover
    ? (post.data.cover.startsWith('http') ? post.data.cover : `/images/posts/${post.data.cover}`)
    : post.data.socialImage;

const toc = headings.filter((h) => h.depth === 2);

// Series thread + pager (redesign-plan.md §7): series wins, chronological is
// the fallback per side. Pager is English-only for now — the small set of
// translated posts don't have a bilingual reading order worth inventing.
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const enPosts = allPosts
    .filter((p) => (p.data.lang ?? 'en') === 'en')
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// English slug -> its Italian translation entry, if one exists — lets the
// series aside show localized titles/links when reading the Italian version
// of a post, even though series membership and order only live on the
// English frontmatter (comment above enPosts).
const itPostBySourceSlug = new Map(
    allPosts
        .filter((p): p is typeof p & { data: { translationOf: string } } => p.data.lang === 'it' && !!p.data.translationOf)
        .map((p) => [p.data.translationOf, p]),
);

let seriesMeta: { slug: string; label: string; position: number; posts: { slug: string; title: string; href: string; order: number; isCurrent: boolean }[] } | null = null;
if (post.data.series) {
    const seriesSlug = post.data.series.slug;
    const seriesPosts = enPosts
        .filter((p) => p.data.series?.slug === seriesSlug)
        .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0));
    const idx = seriesPosts.findIndex((p) => getPostSlug(p) === slug);
    seriesMeta = {
        slug: seriesSlug,
        label: getSeriesEntry(seriesSlug)?.metaLabel ?? seriesSlug,
        position: idx + 1,
        posts: seriesPosts.map((p, i) => {
            const pSlug = getPostSlug(p);
            const isCurrent = pSlug === slug;
            const itPost = itPostBySourceSlug.get(pSlug);
            const useIt = lang === 'it' && !!itPost;
            return {
                slug: pSlug,
                title: isCurrent ? post.data.title : useIt ? itPost!.data.title : p.data.title,
                href: useIt ? `/posts/${pSlug}/it/` : `/posts/${pSlug}/`,
                order: i + 1,
                isCurrent,
            };
        }),
    };
}

let prevPost: CollectionEntry<'posts'> | undefined;
let nextPost: CollectionEntry<'posts'> | undefined;
let prevViaSeries = false;
let nextViaSeries = false;

if (lang === 'en') {
    if (seriesMeta) {
        const sIdx = seriesMeta.position - 1;
        if (sIdx > 0) {
            prevPost = enPosts.find((p) => getPostSlug(p) === seriesMeta!.posts[sIdx - 1].slug);
            prevViaSeries = true;
        }
        if (sIdx < seriesMeta.posts.length - 1) {
            nextPost = enPosts.find((p) => getPostSlug(p) === seriesMeta!.posts[sIdx + 1].slug);
            nextViaSeries = true;
        }
    }
    const chronoIdx = enPosts.findIndex((p) => getPostSlug(p) === slug);
    if (!prevPost && chronoIdx > 0) prevPost = enPosts[chronoIdx - 1];
    if (!nextPost && chronoIdx < enPosts.length - 1) nextPost = enPosts[chronoIdx + 1];
}

function ordinal(n: number, lang: 'en' | 'it'): string {
    if (lang === 'it') return `${n}°`;
    const j = n % 10;
    const k = n % 100;
    if (j === 1 && k !== 11) return `${n}st`;
    if (j === 2 && k !== 12) return `${n}nd`;
    if (j === 3 && k !== 13) return `${n}rd`;
    return `${n}th`;
}

const discussionRepo = post.data.discussion ?? siteConfig.discussionRepo;
const discussionUrl = `https://github.com/${discussionRepo}/discussions`;

const articleImageURL = new URL(post.data.socialImage ?? siteConfig.author.photo, siteConfig.url).toString();
const postCanonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const blogPostingSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: articleImageURL,
    datePublished: post.data.date.toISOString(),
    author: { '@id': `${siteConfig.url}/#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': postCanonicalURL },
};
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    image={post.data.socialImage}
    article={true}
    lang={lang}
    hreflangEn={hreflangEn}
    hreflangIt={hreflangIt}
>
  <!-- Shell B, three column (redesign-plan.md §5): rail | article | aside -->
  <div class="post-shell min-[900px]:grid min-[900px]:grid-cols-[14rem_minmax(0,1fr)] min-[1180px]:grid-cols-[14rem_minmax(0,1fr)_15rem] max-w-[82rem] mx-auto">
    <Rail />
    <div class="post-shell-main min-w-0 min-[900px]:col-start-2">
      <div class="flex justify-end px-6 pt-6 min-[900px]:px-8 min-[900px]:pt-8">
        <ThemeSwitcher />
      </div>
    <main id="main-content" class="px-6 pb-12 min-[900px]:px-8 min-[900px]:pb-16">
    <article class="post-content">
        <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

        <header class="mb-8 max-w-[68ch]">
            {post.data.category && (
                <p class="eyebrow font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-accent mb-3">
                    {post.data.category}
                </p>
            )}
            <h1 class="font-sans text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.15] tracking-[-0.025em] font-[660] mb-4 max-w-[26ch] text-ink dark:text-white">
                {post.data.title}
            </h1>
            {post.data.description && (
                <p class="standfirst text-lg text-ink-2 mb-6 max-w-[60ch]">
                    {post.data.description}
                </p>
            )}
            <div class="meta font-mono text-xs text-muted flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-b border-rule py-3">
                <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
                <span>{readTime}</span>
                {postItalianUrl && (
                    <PostLangSwitch lang={lang} englishUrl={postEnglishUrl} italianUrl={postItalianUrl} />
                )}
                {seriesMeta && (
                    <span>{ordinal(seriesMeta.position, lang)} {lang === 'it' ? 'in' : 'in the'} {seriesMeta.label}</span>
                )}
            </div>
        </header>

        {coverSrc && (
            <figure class="mb-10">
                <img
                    src={coverSrc}
                    alt={post.data.coverAlt ?? post.data.title}
                    width="1200"
                    height="628"
                    loading="eager"
                    fetchpriority="high"
                    class="w-full aspect-[1.91/1] object-cover border border-rule"
                />
            </figure>
        )}

        {toc.length > 0 && (
            <details class="toc-mobile min-[1180px]:hidden mb-8 border border-rule px-4 py-3 not-prose">
                <summary class="font-mono text-xs uppercase tracking-[0.1em] text-muted cursor-pointer">
                    {lang === 'it' ? 'In questa pagina' : 'On this page'}
                </summary>
                <ul class="toc-list mt-3 font-mono text-sm leading-relaxed">
                    {toc.map((h) => (
                        <li>
                            <a href={`#${h.slug}`} class="block py-[0.25rem] pl-3 border-l-2 border-rule-soft text-ink-2 hover:text-ink hover:border-muted transition-colors">{h.text}</a>
                        </li>
                    ))}
                </ul>
            </details>
        )}

        {seriesMeta && (
            <details class="series-mobile min-[1180px]:hidden mb-8 border border-rule px-4 py-3 not-prose">
                <summary class="font-mono text-xs uppercase tracking-[0.1em] text-muted cursor-pointer">
                    {seriesMeta.label}
                </summary>
                <ul class="mt-3 font-mono text-sm leading-relaxed">
                    {seriesMeta.posts.map((p) => (
                        <li class="flex py-[0.25rem]">
                            <span class="text-muted shrink-0 w-3">{p.order}</span>
                            {p.isCurrent ? (
                                <span class="text-accent font-semibold">{p.title}</span>
                            ) : (
                                <a href={p.href} class="text-ink-2 hover:text-accent">{p.title}</a>
                            )}
                        </li>
                    ))}
                </ul>
                <a href={`/series/${seriesMeta.slug}/`} class="block mt-3 pt-3 border-t border-rule-soft font-mono text-sm text-accent hover:underline">
                    {lang === 'it' ? 'Vedi la serie' : 'View series'} &rarr;
                </a>
            </details>
        )}

        <!-- Prose body at reading measure -->
        <div class="prose dark:prose-invert max-w-[68ch]">
            <slot />
        </div>

        <!-- Endnote block (redesign-plan.md §7): tags, author, subscribe, discussion, pager -->
        <div class="endnote mt-12 pt-6 border-t border-rule max-w-[68ch]">
            {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags flex flex-wrap gap-2 mb-7 font-mono text-xs">
                    {post.data.tags.map((tag) => (
                        <a
                            href={`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
                            class="border border-rule text-muted px-2 py-0.5 hover:text-accent hover:border-accent transition-colors"
                        >
                            #{tag}
                        </a>
                    ))}
                </div>
            )}

            <div class="post-author flex items-center gap-3 mb-7">
                <img
                    src={siteConfig.author.photo}
                    alt={siteConfig.author.name}
                    class="w-11 h-11 rounded-full"
                />
                <div>
                    <p class="font-sans font-semibold text-sm text-ink dark:text-white">{siteConfig.author.name}</p>
                    <p class="text-sm text-muted">{siteConfig.author.bio}</p>
                </div>
            </div>

            <div
                class="post-newsletter border border-rule px-5 py-5 mb-6"
                transition:persist
                transition:name="newsletter-signup"
            >
                <h2 class="text-base font-semibold text-ink dark:text-white mb-1">Liked this? Get the next one.</h2>
                <p class="text-sm text-ink-2 leading-relaxed mb-4">
                    Practical notes on Laravel tooling and AI-assisted development, about once a month.
                    Join the list and I'll send you my
                    <a href="/cheatsheets/spatie-event-sourcing/" class="text-accent underline">Spatie Event Sourcing cheat sheet</a>
                    to start.
                </p>
                <NewsletterSignup />
            </div>

            <div class="discuss border-t border-rule-soft pt-4 mb-7 font-mono text-sm text-muted leading-relaxed">
                {lang === 'it' ? 'Hai trovato un errore, o non sei d’accordo?' : 'Found a mistake, or disagree?'}{' '}
                <a href={discussionUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                    {lang === 'it' ? 'Apri una discussione su GitHub' : 'Open a discussion on GitHub'}
                </a>{' '}
                {lang === 'it' ? 'o ' : 'or '}
                <a href="mailto:hello@albertoarena.it" class="text-accent hover:underline">
                    {lang === 'it' ? 'inviami un’email' : 'send me an email'}
                </a>.
            </div>

            {(prevPost || nextPost) && (
                <nav class="pager grid grid-cols-1 min-[560px]:grid-cols-2 gap-5" aria-label="Post navigation">
                    {prevPost ? (
                        <a href={`/posts/${getPostSlug(prevPost)}/`} class="border-t border-rule pt-3 group">
                            <span class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-muted block">
                                &larr; {prevViaSeries ? 'Previous in thread' : 'Previous post'}
                            </span>
                            <span class="font-sans text-[0.9375rem] font-medium leading-snug mt-1 block group-hover:text-accent">
                                {prevPost.data.title}
                            </span>
                        </a>
                    ) : <span />}
                    {nextPost && (
                        <a href={`/posts/${getPostSlug(nextPost)}/`} class="border-t border-rule pt-3 text-right group">
                            <span class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-muted block">
                                {nextViaSeries ? 'Next in thread' : 'Next post'} &rarr;
                            </span>
                            <span class="font-sans text-[0.9375rem] font-medium leading-snug mt-1 block group-hover:text-accent">
                                {nextPost.data.title}
                            </span>
                        </a>
                    )}
                </nav>
            )}
        </div>
    </article>
    </main>
      <Footer />
    </div>

    <aside class="hidden min-[1180px]:flex flex-col gap-8 border-l border-rule px-5 py-9 sticky top-0 self-start h-screen overflow-y-auto">
        {toc.length > 0 && (
            <div>
                <h4 class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-muted mb-2.5">
                    {lang === 'it' ? 'In questa pagina' : 'On this page'}
                </h4>
                <ul id="toc" class="font-mono text-xs leading-[1.55]">
                    {toc.map((h) => (
                        <li>
                            <a href={`#${h.slug}`} class="toc-link block py-[0.3rem] pl-3 text-muted hover:text-ink transition-colors" data-target={h.slug}>{h.text}</a>
                        </li>
                    ))}
                </ul>
            </div>
        )}

        {seriesMeta && (
            <div>
                <h4 class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-muted mb-2.5">
                    <a href={`/series/${seriesMeta.slug}/`} class="hover:text-accent">{seriesMeta.label}</a>
                </h4>
                <ul class="font-mono text-xs leading-[1.5]">
                    {seriesMeta.posts.map((p) => (
                        <li class="flex py-[0.3rem]">
                            <span class="text-muted shrink-0 w-3">{p.order}</span>
                            {p.isCurrent ? (
                                <span class="text-accent font-semibold">{p.title}</span>
                            ) : (
                                <a href={p.href} class="text-ink-2 hover:text-accent">{p.title}</a>
                            )}
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </aside>
  </div>

  <ReadingModeToggle />
  <CookieConsent />
</BaseLayout>

<script>
  /*
    Deliberately not IntersectionObserver. That approach tracked the highest
    ratio any heading had *ever* reported and never invalidated it, so a
    heading briefly passed through mid-scroll (e.g. clicking a TOC link that
    triggers the smooth-scroll jump) could register a high ratio and then
    stay "active" even after landing somewhere else — most visible jumping
    backward across several headings at once. Tracking scroll position
    directly and asking "which heading has most recently crossed the line"
    is stateless (recomputed fresh every scroll tick), so there's nothing to
    go stale.
  */
  let currentScrollHandler: (() => void) | undefined;

  function initToc() {
    if (currentScrollHandler) {
      window.removeEventListener('scroll', currentScrollHandler);
      currentScrollHandler = undefined;
    }

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#toc a[data-target]'));
    const headingEls = links
      .map((a) => document.getElementById(a.dataset.target!))
      .filter((el): el is HTMLElement => !!el);

    if (!headingEls.length) return;

    const activeLine = () => window.innerHeight * 0.2;

    function updateActive() {
      const line = activeLine();
      let current = headingEls[0].id;
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top <= line) {
          current = el.id;
        } else {
          break;
        }
      }
      links.forEach((a) => {
        a.classList.toggle('toc-active', a.dataset.target === current);
      });
    }

    let ticking = false;
    currentScrollHandler = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        updateActive();
      });
    };

    window.addEventListener('scroll', currentScrollHandler, { passive: true });
    updateActive();
  }

  initToc();
  document.addEventListener('astro:after-swap', initToc);
</script>
