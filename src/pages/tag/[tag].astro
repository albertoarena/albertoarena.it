---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import PostListRow from "../../components/PostListRow.astro";
import { buildSeriesTotals, getSeriesMarker } from "../../data/series";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    const englishPosts = posts.filter((post) => (post.data.lang ?? 'en') === 'en');
    const allTags = englishPosts.flatMap((post) => post.data.tags || []);
    const uniqueTags = [...new Set(allTags)];

    // Same reasoning as category/[category].astro: totals need every post
    // site-wide, a series can span tags just like it can span categories.
    const seriesTotals = buildSeriesTotals(englishPosts.filter((post) => !post.data.draft));

    return uniqueTags.map((tag) => ({
        params: { tag: tag.toLowerCase().replace(/\s+/g, '-') },
        props: {
            tag,
            posts: englishPosts
                .filter((post) => post.data.tags?.includes(tag) && !post.data.draft)
                .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
            seriesTotals,
        },
    }));
}

const { tag, posts, seriesTotals } = Astro.props;
---

<Layout title={`Tag: ${tag}`} noindex>
    <h1 class="font-sans text-3xl font-bold text-ink dark:text-white mb-3">
        #{tag}
    </h1>
    <p class="text-ink-2 mb-10">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} with this tag.
    </p>
    <ul class="border-t border-rule">
        {posts.map((post) => <PostListRow post={post} seriesMarker={getSeriesMarker(post, seriesTotals)} />)}
    </ul>
</Layout>
