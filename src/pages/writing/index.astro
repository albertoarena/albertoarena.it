---
import Layout from "@/components/Layout.astro";
import PostListRow from "@/components/PostListRow.astro";
import Pagination from "@/components/Pagination.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "@/utils/config";
import { buildSeriesTotals, getSeriesMarker } from "@/data/series";

const posts = await getCollection("posts", ({ data }) => !data.draft && (data.lang ?? 'en') === 'en');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const seriesTotals = buildSeriesTotals(sortedPosts);

const { postsLimit } = siteConfig;
const totalPages = Math.ceil(sortedPosts.length / postsLimit);
const pagePosts = sortedPosts.slice(0, postsLimit);
---

<Layout title={`Writing — ${siteConfig.title}`} description="Every post, newest first.">
  <div class="flex items-baseline justify-between gap-4 mb-8">
    <h1 class="font-sans text-3xl font-bold text-ink dark:text-white">Writing</h1>
    <a href="/archive/" class="font-mono text-xs text-muted hover:text-accent transition-colors whitespace-nowrap">
      all {sortedPosts.length} posts by year &rarr;
    </a>
  </div>

  <ul class="border-t border-rule">
    {pagePosts.map((post) => (
      <PostListRow post={post} seriesMarker={getSeriesMarker(post, seriesTotals)} />
    ))}
  </ul>

  <Pagination currentPage={1} totalPages={totalPages} basePath="/writing" />
</Layout>
