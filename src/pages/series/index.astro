---
import Layout from '@/components/Layout.astro';
import { getCollection } from 'astro:content';
import { seriesRegistry } from '@/data/series';

const posts = await getCollection('posts', ({ data }) => !data.draft && (data.lang ?? 'en') === 'en');

const entries = seriesRegistry.map((entry) => ({
  ...entry,
  count: posts.filter((p) => p.data.series?.slug === entry.slug).length,
})).filter((entry) => entry.count > 0);

const pinnedEntries = entries.filter((entry) => entry.pinned);
const regularEntries = entries.filter((entry) => !entry.pinned);
---

<Layout
  title="Series"
  description="Posts grouped into a deliberate reading order, where one exists."
>
  <h1 class="font-sans text-3xl font-bold text-ink dark:text-white mb-3">Series</h1>
  <p class="text-ink-2 mb-10 max-w-[60ch]">
    Most posts stand alone. These are the ones that don't: a deliberate order worth reading in sequence.
  </p>

  {pinnedEntries.length > 0 && (
    <div class="mb-8">
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-3">&#9733; Pinned</p>
      <ul class="border-t border-rule">
        {pinnedEntries.map((entry) => (
          <li class="border-b border-rule py-5">
            <a href={`/series/${entry.slug}/`} class="group flex items-baseline justify-between gap-4">
              <span>
                <span class="font-sans text-lg font-semibold text-ink dark:text-white group-hover:text-accent transition-colors">
                  {entry.title}
                </span>
                <span class="block text-ink-2 mt-1 max-w-[52ch]">{entry.description}</span>
              </span>
              <span class="font-mono text-xs text-muted whitespace-nowrap shrink-0">
                {entry.count} post{entry.count === 1 ? '' : 's'} &rarr;
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <ul class="border-t border-rule">
    {regularEntries.map((entry) => (
      <li class="border-b border-rule py-5">
        <a href={`/series/${entry.slug}/`} class="group flex items-baseline justify-between gap-4">
          <span>
            <span class="font-sans text-lg font-semibold text-ink dark:text-white group-hover:text-accent transition-colors">
              {entry.title}
            </span>
            <span class="block text-ink-2 mt-1 max-w-[52ch]">{entry.description}</span>
          </span>
          <span class="font-mono text-xs text-muted whitespace-nowrap shrink-0">
            {entry.count} post{entry.count === 1 ? '' : 's'} &rarr;
          </span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
