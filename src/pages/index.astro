---
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { siteConfig } from "../utils/config";

const posts = await getCollection("posts");
const sortedPosts = posts
	.filter((post) => !post.data.draft && (post.data.lang ?? 'en') === 'en')
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pinnedPosts = sortedPosts.filter((p) => p.data.pinned);
const regularPosts = sortedPosts.filter((p) => !p.data.pinned);

const { postsLimit } = siteConfig;
const totalPages = Math.ceil(regularPosts.length / postsLimit);
const pagePosts = regularPosts.slice(0, postsLimit);
---

<Layout title={siteConfig.title}>
	<section class="mb-12 pb-10 border-b border-white-cloud dark:border-dark-cloud">
		<p class="text-2xl font-semibold text-dark dark:text-white leading-snug">
			Senior software engineer.
		</p>
		<p class="mt-3 text-gray leading-relaxed">
			I build and maintain developer tooling for Laravel and event sourcing.
		</p>
		<p class="mt-2 text-sm font-mono">
			<a href="/pages/consulting/" class="text-primary hover:text-secondary transition-colors">Open to freelance, consulting, and long-term remote collaborations.</a>
		</p>
	</section>

	<div class="mb-12 p-5 rounded-lg border border-white-cloud dark:border-dark-cloud border-l-4 border-l-primary dark:border-l-primary flex items-start gap-4">
		<svg class="truss-icon w-10 h-10 flex-shrink-0" viewBox="0 0 32 32" aria-hidden="true">
			<path d="M16 5 L27 26 H5 Z" />
			<path d="M16 5 V17" />
			<path d="M5 26 L16 17" />
			<path d="M27 26 L16 17" />
			<circle cx="16" cy="5" r="2.4" />
			<circle cx="5" cy="26" r="2.4" />
			<circle cx="27" cy="26" r="2.4" />
			<circle cx="16" cy="17" r="2.4" />
		</svg>
		<div>
			<h2 class="text-lg font-semibold text-dark dark:text-white">Truss</h2>
			<p class="mt-1 text-gray leading-relaxed">
				A live, zoomable ER diagram of your Laravel app's actual database schema, safe to run in production because it only ever reads structure, never rows. <strong>Now with <span class="font-mono">truss:doctor</span>, a CI-ready schema health check.</strong>
			</p>
			<div class="mt-3 flex flex-wrap items-center gap-4 text-sm">
				<a
					href="https://github.com/albertoarena/laravel-truss"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 text-gray hover:text-primary transition-colors"
				>
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill-rule="evenodd"
							d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
							clip-rule="evenodd"
						/>
					</svg>
					GitHub
				</a>
				<a
					href="https://trussphp.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 text-gray hover:text-primary transition-colors"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
						/>
					</svg>
					Docs
				</a>
				<a
					href="/posts/introducing-truss/"
					class="inline-flex items-center gap-1.5 text-gray hover:text-primary transition-colors"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
						/>
					</svg>
					Read more
				</a>
			</div>
		</div>
	</div>

	<style>
		.truss-icon path {
			fill: none;
			stroke: var(--color-primary);
			stroke-width: 1.7;
			stroke-linejoin: miter;
		}
		.truss-icon circle {
			fill: var(--color-primary);
		}
	</style>

	{pinnedPosts.length > 0 && (
		<div class="mb-10">
			<p class="text-xs font-mono text-gray uppercase tracking-widest mb-5">★ Pinned</p>
			<div class="space-y-8">
				{pinnedPosts.map((post) => <PostCard post={post} pinned={true} />)}
			</div>
		</div>
		<hr class="border-white-cloud dark:border-dark-cloud mb-10" />
	)}

	<div class="space-y-8 animate-stagger">
		{pagePosts.map((post) => <PostCard post={post} />)}
	</div>

	<Pagination currentPage={1} totalPages={totalPages} />
</Layout>