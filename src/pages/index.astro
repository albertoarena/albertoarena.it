---
import Layout from "../components/Layout.astro";
import TrussPromo from "../components/TrussPromo.astro";
import PostListRow from "../components/PostListRow.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../utils/config";
import { getPostSlug } from "../utils/helpers";
import { buildSeriesTotals, getSeriesMarker } from "../data/series";
import readingTime from "reading-time";

const posts = await getCollection("posts", ({ data }) => !data.draft && (data.lang ?? 'en') === 'en');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const seriesTotals = buildSeriesTotals(sortedPosts);

// Newest post is the featured slot, not necessarily whichever is `pinned`
// (pinned is used for /series instead) — this also avoids featuring a
// Truss post immediately under the dedicated Truss block above it.
const [featured, ...rest] = sortedPosts;
const pinnedPosts = rest.filter((p) => p.data.pinned);
const listPosts = rest.filter((p) => !p.data.pinned).slice(0, 6);

const featuredSlug = getPostSlug(featured);
const featuredReadTime = readingTime(featured.body).text;
const featuredCover = featured.data.cover
	? (featured.data.cover.startsWith('http') ? featured.data.cover : `/images/posts/${featured.data.cover}`)
	: featured.data.socialImage;
---

<Layout title={siteConfig.title} wide>
	<section class="mb-9 pb-8 border-b-[3px] border-double border-rule">
		<h1 class="font-sans text-2xl font-semibold text-ink dark:text-white leading-snug mb-3">
			Senior software engineer.
		</h1>
		<p class="text-ink-2 leading-relaxed max-w-[60ch]">
			I build and maintain developer tooling for Laravel and event sourcing.
		</p>
		<p class="mt-3 font-mono text-sm">
			<span class="inline-block w-[0.45rem] h-[0.45rem] rounded-full bg-ok mr-1.5" aria-hidden="true"></span>
			<a href="/pages/consulting/" class="text-accent hover:underline">Open to freelance, consulting, and long-term remote collaborations.</a>
		</p>
	</section>

	<!--
		Ledger identity, two-lane layout (.impeccable/surfaces/site.md): Building
		and Writing run side by side instead of stacking, the only direction of
		the three compared that actually shortens the page. Collapses to one
		column below 1360px — comfortably before either lane gets too narrow for
		Truss's link row or the post list's metadata to read well — with Building
		first in document order, so Truss keeps top billing at every width.
	-->
	<section class="grid grid-cols-1 min-[1360px]:grid-cols-2 gap-10 mb-11 items-start">
		<div>
			<div class="flex items-baseline justify-between gap-4 border-b border-rule pb-2 mb-5">
				<h2 class="font-mono text-xs uppercase tracking-[0.14em] text-ink dark:text-white font-semibold">Building</h2>
			</div>
			<TrussPromo />
			<div class="border border-rule px-5 py-4 mt-5 flex flex-wrap items-baseline justify-between gap-3">
				<p class="text-ink-2 max-w-[44ch]"><strong class="font-semibold text-ink dark:text-white">Cogway:</strong> interactive explainers for Laravel and PHP, one mechanism at a time.</p>
				<a href="https://cogway.dev/?utm_source=albertoarena.it&amp;utm_medium=referral&amp;utm_campaign=home" target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-accent hover:underline whitespace-nowrap">cogway.dev &rarr;</a>
			</div>
		</div>

		<div>
			<div class="flex items-baseline justify-between gap-4 border-b border-rule pb-2 mb-5">
				<h2 class="font-mono text-xs uppercase tracking-[0.14em] text-ink dark:text-white font-semibold">Writing</h2>
				<a href="/archive/" class="font-mono text-xs text-muted hover:text-accent transition-colors whitespace-nowrap">all {sortedPosts.length} posts by year &rarr;</a>
			</div>

			<a href={`/posts/${featuredSlug}/`} class="group grid grid-cols-1 min-[560px]:grid-cols-[13rem_minmax(0,1fr)] gap-5 items-start mb-8">
				{featuredCover ? (
					<img
						src={featuredCover}
						alt={featured.data.coverAlt ?? featured.data.title}
						width="1200"
						height="628"
						loading="lazy"
						class="w-full aspect-[1.91/1] object-cover border border-rule"
					/>
				) : (
					<div class="w-full aspect-[1.91/1] border border-rule flex items-center justify-center font-mono text-[0.6rem] text-muted text-center px-2">
						{featured.data.title}
					</div>
				)}
				<div class="min-w-0">
					<p class="font-mono text-xs uppercase tracking-[0.14em] text-accent mb-1.5">&#9733; Latest</p>
					<h3 class="font-sans text-lg font-semibold text-ink dark:text-white group-hover:text-accent transition-colors mb-1.5">
						{featured.data.title}
					</h3>
					{featured.data.description && (
						<p class="text-ink-2 mb-2 max-w-[52ch]">{featured.data.description}</p>
					)}
					<p class="font-mono text-xs text-muted flex flex-wrap items-center gap-x-2">
						<span>
							{featured.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
							{featured.data.category && <> &middot; {featured.data.category}</>}
							&middot; {featuredReadTime}
						</span>
						{featured.data.sourcesVerified && <span class="stamp">&#10003; Sources checked</span>}
					</p>
				</div>
			</a>

			{pinnedPosts.length > 0 && (
				<div class="mb-8">
					<p class="font-mono text-xs uppercase tracking-widest text-muted mb-3">&#9733; Pinned</p>
					<ul>
						{pinnedPosts.map((post) => (
							<PostListRow post={post} seriesMarker={getSeriesMarker(post, seriesTotals)} pinned />
						))}
					</ul>
				</div>
			)}

			<ul class="border-t border-rule">
				{listPosts.map((post) => (
					<PostListRow post={post} seriesMarker={getSeriesMarker(post, seriesTotals)} />
				))}
			</ul>
		</div>
	</section>

	<!-- Closing band: three teasers in one row instead of three full-width stacked sections -->
	<section class="border-t-[3px] border-double border-rule pt-8 mb-11">
		<div class="grid grid-cols-1 min-[640px]:grid-cols-3 gap-8">
			<div>
				<h2 class="font-mono text-xs uppercase tracking-[0.14em] text-ink dark:text-white font-semibold mb-2">Cheat sheets</h2>
				<p class="text-ink-2 mb-2">Dense, printable references for the tools I use daily. Spatie event sourcing is the first one, with a one-page PDF.</p>
				<a href="/cheatsheets/" class="font-mono text-sm text-accent hover:underline whitespace-nowrap">Browse &rarr;</a>
			</div>
			<div>
				<h2 class="font-mono text-xs uppercase tracking-[0.14em] text-ink dark:text-white font-semibold mb-2">Other projects</h2>
				<p class="text-ink-2 mb-2">An event sourcing generator with 10,000+ installs, a Claude Code skill for designing event sourced domains, env validation for pipelines, and deploys for Netsons servers.</p>
				<a href="/projects/" class="font-mono text-sm text-accent hover:underline whitespace-nowrap">See all &rarr;</a>
			</div>
			<div>
				<h2 class="font-mono text-xs uppercase tracking-[0.14em] text-ink dark:text-white font-semibold mb-2">Working with me</h2>
				<p class="text-ink-2 mb-2">Event sourcing, Laravel codebases, tooling and CI, scoped to what the project actually needs.</p>
				<a href="/pages/consulting/" class="font-mono text-sm text-accent hover:underline whitespace-nowrap">Availability &rarr;</a>
			</div>
		</div>
	</section>

	<section class="border border-rule px-6 py-6" transition:persist transition:name="newsletter-signup">
		<h3 class="font-sans text-lg font-semibold text-ink dark:text-white mb-1.5">Get the next one</h3>
		<p class="text-ink-2 max-w-[52ch] mb-4">
			Practical notes on Laravel tooling and AI-assisted development, about once a month. New subscribers get the
			<a href="/cheatsheets/spatie-event-sourcing/" class="text-accent underline">Spatie Event Sourcing cheat sheet</a>
			as a printable PDF.
		</p>
		<NewsletterSignup />
	</section>
</Layout>
