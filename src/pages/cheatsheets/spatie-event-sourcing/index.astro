---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { siteConfig } from '@/utils/config';
import { getPostSlug } from '@/utils/helpers';
import {
  spatieEventSourcingCheatsheet,
  automateThisFooter,
  relatedPostSlugs,
} from '@/data/cheatsheets/spatie-event-sourcing';

const cardSections = spatieEventSourcingCheatsheet.sections.filter((s) => !s.flow);
const flowSection = spatieEventSourcingCheatsheet.sections.find((s) => s.flow);

const allPosts = await getCollection('posts');
const relatedPosts = relatedPostSlugs
  .map((slug) => allPosts.find((p) => getPostSlug(p) === slug))
  .filter((p) => p !== undefined);

const pdfPath = '/downloads/spatie-event-sourcing-cheatsheet.pdf';
const canonicalPath = '/cheatsheets/spatie-event-sourcing/';
const canonicalURL = new URL(canonicalPath, siteConfig.url).toString();
---

<Layout
  title={spatieEventSourcingCheatsheet.title}
  description={spatieEventSourcingCheatsheet.description}
  image="/images/cheatsheets/spatie-event-sourcing/cover.jpg"
  wide={true}
>
  <div class="cheatsheet-header mb-10">
    <p class="text-sm font-medium text-primary mb-2">Cheat sheet</p>
    <h1 class="text-3xl lg:text-4xl font-bold text-dark dark:text-white mb-3">
      {spatieEventSourcingCheatsheet.title}
    </h1>
    <p class="text-gray leading-relaxed max-w-2xl mb-2">
      {spatieEventSourcingCheatsheet.description}
    </p>
    <p class="print-only text-xs text-gray mb-6">
      Printed from <a href={canonicalURL}>{canonicalURL}</a> by {siteConfig.author.name}.
    </p>
    <a
      href={pdfPath}
      target="_blank"
      rel="noopener noreferrer"
      class="print-hide inline-flex items-center gap-2 px-4 py-2 mt-4 rounded-lg bg-primary text-white text-sm font-medium hover:bg-secondary transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
      </svg>
      Download the printable PDF
    </a>
  </div>

  {flowSection && (
    <section class="mb-10 cheatsheet-card rounded-lg border border-white-cloud dark:border-dark-cloud p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray mb-4">
        {flowSection.title}
      </h2>
      <div class="cheatsheet-flow flex flex-col gap-2 font-mono text-xs sm:text-sm">
        {flowSection.flow!.map((step, i) => (
          <>
            <span
              class="px-3 py-1.5 rounded bg-gray-100 dark:bg-dark-cloud/60 text-dark dark:text-white w-fit"
              style={`margin-left: ${i * 20}px`}
            >
              {step}
            </span>
            {i < flowSection.flow!.length - 1 && (
              <span class="text-gray" style={`margin-left: ${i * 20 + 12}px`} aria-hidden="true">&darr;</span>
            )}
          </>
        ))}
      </div>
    </section>
  )}

  <div class="cheatsheet-grid columns-1 sm:columns-2 gap-6 mb-12">
    {cardSections.map((section) => (
      <section class="cheatsheet-card break-inside-avoid mb-6 rounded-lg border border-white-cloud dark:border-dark-cloud p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray mb-3">
          {section.title}
        </h2>
        <ul class="space-y-2.5">
          {section.entries!.map((entry) => (
            <li class="text-sm leading-relaxed text-dark dark:text-white">
              {entry.code && (
                <code class="block font-mono text-xs sm:text-sm bg-gray-100 dark:bg-dark-cloud/60 rounded px-1.5 py-0.5 mb-1 break-words">{entry.code}</code>
              )}
              {entry.term && <strong class="font-semibold">{entry.term}:</strong>}{' '}
              <span class="text-gray">{entry.text}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {relatedPosts.length > 0 && (
    <section class="mb-12 print-hide rounded-lg border border-white-cloud dark:border-dark-cloud p-5">
      <h2 class="text-lg font-semibold text-dark dark:text-white mb-3">
        Related reading
      </h2>
      <div class="grid gap-3 sm:grid-cols-3">
        {relatedPosts.map((post) => (
          <a
            href={`/posts/${getPostSlug(post)}/`}
            class="group flex items-center gap-3 rounded-lg border border-white-cloud dark:border-dark-cloud p-3 hover:border-primary/50 transition-colors"
          >
            <img
              src={post.data.socialImage ?? siteConfig.author.photo}
              alt=""
              class="w-14 h-14 rounded object-cover shrink-0"
              loading="lazy"
            />
            <span class="text-sm font-medium text-dark dark:text-white group-hover:text-primary transition-colors">{post.data.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mb-12 print-hide rounded-lg border border-white-cloud dark:border-dark-cloud p-5">
    <h2 class="text-lg font-semibold text-dark dark:text-white mb-3">
      Automate all of this
    </h2>
    <ul class="space-y-3">
      {automateThisFooter.map((link) => (
        <li class="text-sm text-gray leading-relaxed">
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="font-mono text-dark dark:text-white hover:text-primary transition-colors underline underline-offset-2">{link.name}</a>: {link.text}
        </li>
      ))}
    </ul>
    <p class="text-sm text-gray mt-3">
      Read the honest comparison: <a href="/posts/generator-vs-ai-skill/" class="hover:text-primary transition-colors underline underline-offset-2">which to reach for, and when</a>.
    </p>
  </section>

  <div class="print-hide rounded-lg border border-white-cloud dark:border-dark-cloud p-5">
    <h2 class="text-lg font-semibold text-dark dark:text-white mb-1">
      Grab the printable one-pager
    </h2>
    <p class="text-sm text-gray leading-relaxed mb-4">
      This page is free to read. Subscribe and I'll send you the printable PDF
      version, plus practical notes on Laravel tooling and AI-assisted
      development, roughly once a month.
    </p>
    <NewsletterSignup />
  </div>
</Layout>

<style is:global>
  .print-only {
    display: none;
  }

  @media print {
    header,
    footer,
    #cookie-consent,
    .print-hide {
      display: none !important;
    }

    .print-only {
      display: block !important;
    }

    * {
      color: #000 !important;
      background-color: transparent !important;
      border-color: #ccc !important;
      box-shadow: none !important;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    body {
      background: #fff !important;
    }

    main {
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    code {
      background-color: #f0f0f0 !important;
    }

    .cheatsheet-grid {
      display: block !important;
      column-count: initial !important;
    }

    .cheatsheet-card {
      display: block !important;
      width: 100% !important;
      break-inside: avoid;
      page-break-inside: avoid;
      padding: 6px 10px !important;
      margin-bottom: 4px !important;
    }

    .cheatsheet-card h2 {
      margin-bottom: 4px !important;
    }

    .cheatsheet-flow {
      gap: 2px !important;
      font-size: 10px !important;
    }

    .cheatsheet-flow span {
      padding: 3px 6px !important;
    }

    .cheatsheet-header {
      margin-bottom: 8px !important;
    }

    .cheatsheet-header h1 {
      font-size: 22px !important;
      margin-bottom: 4px !important;
    }

    .cheatsheet-header p {
      font-size: 11px !important;
      margin-bottom: 2px !important;
    }

    .cheatsheet-card ul {
      display: flex !important;
      flex-direction: column;
      gap: 4px !important;
    }

    .cheatsheet-card li {
      font-size: 11px !important;
      line-height: 1.3 !important;
    }

    pre,
    code {
      font-size: 10px !important;
      white-space: pre-wrap !important;
      word-break: break-word !important;
      overflow-wrap: break-word !important;
    }

    .cheatsheet-card code {
      padding: 1px 4px !important;
      margin-bottom: 2px !important;
    }

    a {
      text-decoration: none !important;
    }

    @page {
      size: A4;
      margin: 12mm;
    }
  }
</style>
