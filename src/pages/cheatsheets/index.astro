---
import Layout from '@/components/Layout.astro';
import { cheatsheets } from '@/data/cheatsheets/registry';
---

<Layout
  title="Cheat sheets"
  description="Dense, printable reference sheets for the tools and patterns I use."
>
  <h1 class="font-sans text-3xl font-bold text-ink dark:text-white mb-3">Cheat sheets</h1>
  <p class="text-ink-2 mb-10 max-w-[60ch]">
    Dense, printable references, free to read, PDF included. More coming as I write them.
  </p>

  <ul class="border-t border-rule">
    {cheatsheets.map((sheet) => (
      <li class="border-b border-rule py-5">
        <a href={`/cheatsheets/${sheet.slug}/`} class="group flex items-baseline justify-between gap-4">
          <span>
            <span class="font-sans text-lg font-semibold text-ink dark:text-white group-hover:text-accent transition-colors">
              {sheet.title}
            </span>
            <span class="block text-ink-2 mt-1 max-w-[52ch]">{sheet.description}</span>
          </span>
          <span class="font-mono text-xs text-muted whitespace-nowrap shrink-0">Read &rarr;</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
