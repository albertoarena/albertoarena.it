---
import Layout from "../components/Layout.astro";
---

<Layout title="Page Not Found">
    <div class="flex flex-col items-center justify-center min-h-[40vh] text-center">
        <h1 class="font-sans text-6xl font-bold text-accent mb-4">404</h1>
        <h2 class="font-sans text-2xl font-semibold text-ink dark:text-white mb-4">Page Not Found</h2>
        <p class="text-ink-2 mb-8 max-w-md">
            The page you're looking for doesn't exist or has been moved.
        </p>
        <a
            href="/"
            class="border border-rule px-6 py-3 font-mono text-sm text-accent hover:border-accent transition-colors"
        >
            Go Home
        </a>
    </div>
</Layout>
