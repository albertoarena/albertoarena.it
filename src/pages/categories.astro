---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";

const posts = await getCollection("posts");
const categoryMap = new Map<string, number>();

posts.filter((post) => !post.data.draft && (post.data.lang ?? 'en') === 'en').forEach((post) => {
    const category = post.data.category;
    if (category) {
        categoryMap.set(category, (categoryMap.get(category) || 0) + 1);
    }
});

const categories = [...categoryMap.entries()]
    .sort((a, b) => b[1] - a[1]);
---

<Layout title="Categories" noindex>
    <h1 class="font-sans text-3xl font-bold text-ink dark:text-white mb-3">Categories</h1>
    <div class="flex flex-wrap gap-4">
        {categories.map(([category, count]) => (
            <a
                href={`/category/${category.toLowerCase().replace(/\s+/g, '-')}/`}
                class="border border-rule text-ink-2 px-3 py-1.5 hover:text-accent hover:border-accent transition-colors"
            >
                {category} <span class="text-muted">({count})</span>
            </a>
        ))}
    </div>
</Layout>
