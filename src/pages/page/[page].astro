---
/*
  The paginated index moved to /writing/page/N/ (redesign-plan.md §9-10).
  This route is kept only as a redirect so old /page/N/ links (search
  results, bookmarks, other posts' inline links) still resolve — same
  getStaticPaths as before the move, so every URL that used to exist still
  gets a page here.
*/
import { getCollection } from "astro:content";
import { siteConfig } from "@/utils/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft && (data.lang ?? 'en') === 'en');
  const { postsLimit } = siteConfig;
  const totalPages = Math.ceil(posts.length / postsLimit);

  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const dest = `/writing/page/${page}/`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting…</title>
    <link rel="canonical" href={dest} />
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <meta name="robots" content="noindex,follow" />
  </head>
  <body>
    <p>This page moved to <a href={dest}>{dest}</a>.</p>
  </body>
</html>
