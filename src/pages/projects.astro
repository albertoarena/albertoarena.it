---
/*
  Redesign /projects (redesign-plan.md §10). The plan's first draft used a
  multi-column grid ("aligned like command output") for the open-source
  list, but that read as an awkward, unevenly-spaced table once real
  descriptions filled it in — replaced with the same stacked-list shape as
  the professional-work section below (name + version/date on one line,
  description, then a muted meta line), which the plan itself calls for
  as "the archived or client work in a second quieter group." Version and
  installs still come from the build-time cache (scripts/fetch-project-
  stats.mjs — "show a dash when unknown, never a zero"). Replaces
  ProjectCard's rounded cards and icon set, both against the plan's
  constraints (§1: no card grids, no icon set).
*/
import Layout from '../components/Layout.astro';
import TrussPromo from '../components/TrussPromo.astro';
import { projects } from '../data/projects';
import projectStats from '../data/project-stats.json';

const openSourceProjects = projects.filter((p) => p.status !== 'professional');
const professionalProjects = projects.filter((p) => p.status === 'professional');

function statsFor(project: (typeof projects)[number]) {
  const key = project.packagist ?? project.npmPackage;
  return key ? (projectStats as Record<string, { version: string | null; installs: number | null }>)[key] : undefined;
}

function hasSeparateDocs(project: (typeof projects)[number]) {
  return !!project.url && project.url !== project.github;
}
---

<Layout title="Projects" description="Open source tools and professional work.">
  <h1 class="font-sans text-3xl font-bold text-ink dark:text-white mb-3">Projects</h1>
  <p class="text-ink-2 mb-10">Open source tools and professional work.</p>

  <TrussPromo />

  <section class="mt-12">
    <h2 class="font-mono text-xs uppercase tracking-[0.14em] text-ink dark:text-white font-semibold border-b border-rule pb-2 mb-2">
      Open source
    </h2>
    <ul class="border-t border-rule-soft">
      {openSourceProjects.map((project) => {
        const stats = statsFor(project);
        return (
          <li class="py-4 border-b border-rule-soft">
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-sans text-base font-semibold text-ink dark:text-white">{project.name}</span>
              <span class="font-mono text-xs text-muted whitespace-nowrap">{stats?.version ?? '—'}</span>
            </div>
            <p class="text-ink-2 mt-1 max-w-[64ch]">{project.description}</p>
            <p class="font-mono text-xs text-muted mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
              <span>{stats?.installs != null ? `${stats.installs.toLocaleString('en-US')} installs` : '— installs'}</span>
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">GitHub</a>
              )}
              {hasSeparateDocs(project) && (
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Docs</a>
              )}
              {project.postSlug && (
                <a href={`/posts/${project.postSlug}/`} class="text-accent hover:underline">Post</a>
              )}
            </p>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="font-mono text-xs uppercase tracking-[0.14em] text-ink dark:text-white font-semibold border-b border-rule pb-2 mb-2">
      Professional work
    </h2>
    <ul class="border-t border-rule-soft">
      {professionalProjects.map((project) => (
        <li class="py-4 border-b border-rule-soft">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-sans text-base font-medium text-ink dark:text-white">
              {project.url ? (
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{project.name}</a>
              ) : project.name}
            </span>
            <span class="font-mono text-xs text-muted whitespace-nowrap">{project.year}</span>
          </div>
          <p class="text-ink-2 mt-1 max-w-[64ch]">{project.description}</p>
          {(project.company || project.role) && (
            <p class="font-mono text-xs text-muted mt-1.5">
              {project.company && (
                project.company.url ? (
                  <a href={project.company.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{project.company.name}</a>
                ) : <span>{project.company.name}</span>
              )}
              {project.company && project.role && ' · '}
              {project.role}
            </p>
          )}
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-ink-2">
      View more on my
      <a href="https://www.linkedin.com/in/alberto-arena-ba44a624/details/projects/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">LinkedIn profile</a>.
    </p>
  </section>
</Layout>
