---
import { getCollection, render } from "astro:content";
import Layout from "../../../components/Layout.astro";
import PostLangSwitch from "../../../components/PostLangSwitch.astro";
import LinkedInCta from "../../../components/LinkedInCta.astro";
import { getPageSlug } from "@/utils/helpers";
import { siteConfig } from "@/utils/config";

export async function getStaticPaths() {
    const allPages = await getCollection("pages");
    const englishPages = allPages.filter((p) => (p.data.lang ?? 'en') === 'en');
    const translatedSlugs = new Set(
        allPages
            .filter((p) => p.data.lang === 'it')
            .map((p) => p.data.translationOf)
            .filter(Boolean)
    );

    return englishPages.map((page) => {
        const slug = getPageSlug(page);
        return {
            params: { slug },
            props: { page, hasItalian: translatedSlugs.has(slug) },
        };
    });
}

const { page, hasItalian } = Astro.props;
const { Content } = await render(page);

const slug = getPageSlug(page);
const englishPath = `/pages/${slug}/`;
const italianPath = `/pages/${slug}/it/`;
---

<Layout
    title={page.data.title}
    lang="en"
    hreflangEn={hasItalian ? `${siteConfig.url}${englishPath}` : undefined}
    hreflangIt={hasItalian ? `${siteConfig.url}${italianPath}` : undefined}
    wide
>
    <!-- Reading measure matches post pages (ledger identity, .impeccable/surfaces/site.md): this page was still on the old narrow Layout default. -->
    <article class="prose dark:prose-invert ledger-measure">
        <h1 class="font-sans text-3xl font-bold text-ink dark:text-white mb-3">{page.data.title}</h1>
        {hasItalian && (
            <div class="meta font-mono text-xs text-muted border-t border-b border-rule py-3 mb-6 not-prose">
                <PostLangSwitch lang="en" englishUrl={englishPath} italianUrl={italianPath} />
            </div>
        )}
        <Content />
        {slug === 'consulting' && <LinkedInCta lang="en" />}
    </article>
</Layout>
